#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"

usage() {
  cat <<'EOF'
Usage:
  bin/run-service <service-name> [extra spring args]

Supported service names:
  gateway
  identity
  access
  tenant
  subscription
  competition
  ranking

Examples:
  bin/run-service gateway
  bin/run-service identity
  bin/run-service competition
  bin/run-service competition --server.port=9085

The script activates Spring profile `local` by default.

Environment overrides:
  ARENAX_DB_HOST         default: localhost
  ARENAX_DB_PORT         default: 5432
  ARENAX_DB_USER         default: postgres
  ARENAX_DB_PASSWORD     default: postgres
  ARENAX_<SERVICE>_DB    per-service database name override

Service defaults:
  identity      -> arenax_identity / 8081
  access        -> arenax_access / 8082
  tenant        -> arenax_tenant / 8083
  subscription  -> arenax_subscription / 8084
  competition   -> arenax_competition / 8085
  ranking       -> arenax_ranking / 8086
  gateway       -> 8080
EOF
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

service_name="$1"
shift

module_path=""

case "$service_name" in
  gateway)
    module_path=":services:api-gateway"
    ;;
  identity)
    module_path=":services:identity-service"
    ;;
  access)
    module_path=":services:access-service"
    ;;
  tenant)
    module_path=":services:tenant-service"
    ;;
  subscription)
    module_path=":services:subscription-service"
    ;;
  competition)
    module_path=":services:competition-service"
    ;;
  ranking)
    module_path=":services:ranking-service"
    ;;
  *)
    echo "Unsupported service name: $service_name" >&2
    echo >&2
    usage
    exit 1
    ;;
esac

declare -a app_args
app_args+=("--spring.profiles.active=local")

while [[ $# -gt 0 ]]; do
  app_args+=("$1")
  shift
done

printf 'Starting %s using module %s\n' "$service_name" "$module_path"
printf 'Application args:\n'
printf '  %s\n' "${app_args[@]}"

cd "$ROOT_DIR"
./gradlew "${module_path}:bootRun" --args="${app_args[*]}"
